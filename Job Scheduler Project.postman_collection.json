	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"function getRandomJson() {\r",
					"    return {\r",
					"        id: Math.floor(Math.random() * 10000),\r",
					"        name: `Item-${Math.floor(Math.random() * 100)}`,\r",
					"        active: Math.random() > 0.5,\r",
					"        time: (Math.random() * 1000).toFixed(2),\r",
					"        createdAt: new Date().toISOString()\r",
					"    };\r",
					"}\r",
					"\r",
					"// Function to generate valid Quartz cron expressions (6-7 fields)\r",
					"function generateValidQuartzCron() {\r",
					"    const patterns = [\r",
					"        // Every X seconds\r",
					"        () => `*/${Math.floor(Math.random() * 30) + 1} * * * * ?`,\r",
					"        \r",
					"        // Every X minutes\r",
					"        () => `0 */${Math.floor(Math.random() * 30) + 1} * * * ?`,\r",
					"        \r",
					"        // Daily at specific time\r",
					"        () => {\r",
					"            const minute = Math.floor(Math.random() * 60);\r",
					"            const hour = Math.floor(Math.random() * 24);\r",
					"            return `0 ${minute} ${hour} * * ?`;\r",
					"        },\r",
					"        \r",
					"        // Weekly on specific day (1-7 where 1=Sunday)\r",
					"        () => {\r",
					"            const minute = Math.floor(Math.random() * 60);\r",
					"            const hour = Math.floor(Math.random() * 24);\r",
					"            const dayOfWeek = Math.floor(Math.random() * 7) + 1;\r",
					"            return `0 ${minute} ${hour} ? * ${dayOfWeek}`;\r",
					"        },\r",
					"        \r",
					"        // Monthly on specific day\r",
					"        () => {\r",
					"            const minute = Math.floor(Math.random() * 60);\r",
					"            const hour = Math.floor(Math.random() * 24);\r",
					"            const dayOfMonth = Math.floor(Math.random() * 28) + 1;\r",
					"            return `0 ${minute} ${hour} ${dayOfMonth} * ?`;\r",
					"        },\r",
					"        \r",
					"        // Your specific example (every 5 minutes) - Quartz version\r",
					"        // () => `0 0/5 * * * ?`\r",
					"    ];\r",
					"\r",
					"    return patterns[Math.floor(Math.random() * patterns.length)]();\r",
					"}\r",
					"\r",
					"\r",
					"pm.collectionVariables.set(\"quartz_cron\", generateValidQuartzCron());\r",
					"pm.collectionVariables.set(\"random_json\", JSON.stringify(getRandomJson()));"
				]
			}
		},
